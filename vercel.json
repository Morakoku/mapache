{
  "buildCommand": "cd backend && pip install -e .",
  "outputDirectory": "backend",
  "devCommand": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "installCommand": "cd backend && pip install -e .",
  "framework": "fastapi",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/$1" }
  ]
}