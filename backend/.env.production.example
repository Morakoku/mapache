# Mapache CRM - Production Environment Variables
# Copia estos valores a Vercel Dashboard → Settings → Environment Variables

# Database (use Supabase Pooler for serverless)
# Get from: Supabase Dashboard → Settings → Database → Connection pooling
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# Security (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=[BASE64_ENCODED_32_BYTES]
SECRET_KEY=[RANDOM_STRING_32_CHARS]

# App
APP_NAME=Mapache CRM
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=https://mapache.vercel.app
FRONTEND_BASE_URL=https://guaki.vercel.app

# CORS (comma-separated)
CORS_ORIGINS=https://guaki.vercel.app,https://mapache.vercel.app

# Service-to-service auth (Hermes → Mapache)
SERVICE_AUTH_ENABLED=true
SERVICE_TOKEN_KEY=[HMAC_SHA256_KEY]
SERVICE_TOKEN_TTL_SECONDS=300
SERVICE_TRUSTED_CLIENT_IDS=hermes
HERMES_SCOPES=hermes.dispatch,hermes.jobs.read
TENANT_ISOLATION_ENFORCED=true

# Localization (Colombia)
DEFAULT_COUNTRY_CODE=CO
DEFAULT_PHONE_REGION=CO
DEFAULT_CURRENCY=COP
DEFAULT_LOCALE=es-CO
DEFAULT_TIMEZONE=America/Bogota

# OAuth (optional - for Gmail/Outlook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Scheduler (disabled in serverless - use Vercel Cron)
SCHEDULER_ENABLED=false
FOLLOWUP_TICK_MINUTES=15
INBOX_SYNC_MINUTES=10

# AI (optional)
ANTHROPIC_API_KEY=
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_SECONDS=90

# Jobs
JOB_QUEUE_BACKEND=inprocess
JOB_MAX_ATTEMPTS=3
JOB_WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Security (LOOP-13)
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
AUDIT_ENABLED=true
IDEMPOTENCY_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
DESTRUCTIVE_CONFIRM_REQUIRED=true