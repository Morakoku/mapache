# ----------------------------------------------------------------- app
APP_NAME="CRM Prospección"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
# A dónde volver tras un callback de OAuth (vacío = página propia del backend).
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- base de datos
# El puerto 5435 es el que expone docker-compose (5432 y 5433 ocupados en esta máquina).
DATABASE_URL=postgresql://crm:crm@localhost:5435/crm
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ----------------------------------------------------------------- seguridad
# Generar cada una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=CAMBIAME_clave_fernet_de_32_bytes_en_base64_urlsafe=
SECRET_KEY=CAMBIAME_secreto_largo_y_aleatorio
# Expiración de la firma de sesión (minutos). 10080 = 7 días.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Token del operador de la Torre de Control (falla cerrado si está vacío).
VEYRA_ADMIN_TOKEN=

# ----------------------------------------------------------------- servicio-a-servicio (L1)
# Autenticación Hermes→Mapache por Bearer token HMAC.
#   formato : Bearer <client_id>.<timestamp>.<nonce>.<signature>
#   firma   : HMAC-SHA256(llave SERVICE_TOKEN_KEY) sobre client_id.timestamp.nonce
#   TTL     : 300 s (SERVICE_TOKEN_TTL_SECONDS), anti-replay por nonce.
# Desactivado por defecto: SERVICE_AUTH_ENABLED=false (local). Para activar:
#   SERVICE_AUTH_ENABLED=true  +  SERVICE_TOKEN_KEY generada en secreto y
#   entregada por un canal seguro (NO se imprime, NO va a git, NO va a logs).
# `SERVICE_TOKEN_KEY` NUNCA lleva un valor real aquí: los valores viven en el
# .env local (gitignored) o en el secret manager de producción.
# Los clientes de servicio permitidos los fija `SERVICE_TRUSTED_CLIENT_IDS`;
# hoy solo existe "hermes". Rotación futura: generate → install → verify →
# revoke/replace (procedimiento en LOOP-07).
SERVICE_AUTH_ENABLED=false
SERVICE_TOKEN_KEY=<placeholder>
SERVICE_TRUSTED_CLIENT_IDS=hermes
SERVICE_TOKEN_TTL_SECONDS=300

# Autorización L2 (LOOP-14): scopes MÍNIMOS de la identidad Hermes (contrato).
# Hermes solo puede: dispatch (POST /api/v1/hermes/dispatch) y leer sus jobs
# (GET /api/v1/hermes/jobs/{id}). NUNCA ampliar: crm.read, scrape.run, jobs.read,
# mail.send, admin o wildcards NO son grantables a identidades de servicio → DENY.
HERMES_SCOPES=hermes.dispatch,hermes.jobs.read
# Identidad Guaki (LOOP-23): solo lectura de prospectos/funnel/links.
GUAKI_SCOPES=guaki.read
# Endurecimiento multi-tenant: obligatorio en producción.
TENANT_ISOLATION_ENFORCED=false

# ----------------------------------------------------------------- seguridad (LOOP-13)
# Cabeceras defensivas (CSP, nosniff, X-Frame-Options, Referrer-Policy).
# `HSTS_ENABLED` SOLO debe activarse cuando haya TLS real delante.
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
# Auditoría best-effort de POST/PATCH/PUT/DELETE + acciones sensibles
# (tabla `audit_log`; nunca guarda bodies ni secretos).
AUDIT_ENABLED=true
# Idempotencia por Idempotency-Key en operaciones con efecto
# (tabla `idempotency_events`; reintento con la misma key → 409).
IDEMPOTENCY_ENABLED=true
# Rate limiting por categoría + IP (email, scraping, settings, jobs, tracking).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# DELETE y cancelación de jobs exigen ?confirm=true.
DESTRUCTIVE_CONFIRM_REQUIRED=true

# ----------------------------------------------------------------- localización (Colombia)
DEFAULT_COUNTRY_CODE=CO
DEFAULT_PHONE_REGION=CO
DEFAULT_CURRENCY=COP
DEFAULT_LOCALE=es-CO
DEFAULT_TIMEZONE=America/Bogota

# ----------------------------------------------------------------- jobs
JOB_QUEUE_BACKEND=inprocess
JOB_WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_STALE_TIMEOUT_SECONDS=300
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_BACKOFF_BASE_SECONDS=2.0
JOB_BACKOFF_MAX_SECONDS=600.0
JOB_BACKOFF_JITTER=0.3

# ----------------------------------------------------------------- planificador
SCHEDULER_ENABLED=true
FOLLOWUP_TICK_MINUTES=15
INBOX_SYNC_MINUTES=10

# ----------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=false

# ----------------------------------------------------------------- OAuth de correo
# Opcional. Sin estas claves la app funciona con SMTP; con ellas se pueden
# conectar buzones de Gmail y Outlook, que dan mejor entregabilidad y push de
# respuestas en vez de polling.
#   Gmail:   https://console.cloud.google.com  -> APIs y servicios -> Credenciales
#            Redirect URI: http://localhost:8000/auth/google/callback
#            Scopes: gmail.send, gmail.readonly, openid, email
#   Outlook: https://portal.azure.com -> Microsoft Entra ID -> Registros de aplicaciones
#            Redirect URI: http://localhost:8000/auth/microsoft/callback
#            Scopes: Mail.Send, Mail.Read, User.Read, offline_access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Contraseña de aplicación de Gmail para scripts locales de prueba (opcional).
GMAIL_APP_PASSWORD=

# ----------------------------------------------------------------- IA (opcional)
# Sin clave, la IA se apaga sola: las plantillas se renderizan y la
# clasificación cae al motor de reglas. Es una mejora, no una dependencia dura.
ANTHROPIC_API_KEY=
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_SECONDS=90

# ----------------------------------------------------------------- Supabase + Resend
# PostgREST (scripts standalone como warmup_resend.py e import_templates_secuencia.py).
SUPABASE_URL=
# Anon/publishable key (respeta RLS). La usa el cliente PostgREST serverless.
SUPABASE_ANON_KEY=
# Service role (bypassa RLS). SOLO server-side. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Envío por Resend (dominio veyrasoluciones.com verificado). La usa el
# warm-up de dominio (scripts/warmup_resend.py; tarea VeyraWarmupDaily
# deshabilitada hasta que esta clave exista AQUÍ, nunca en Vercel solo).
# La clave NUNCA se imprime ni se loguea.
RESEND_API_KEY=

# ----------------------------------------------------------------- WhatsApp Cloud API (Meta)
# Webhook oficial de la Recepcionista IA. En Meta: Webhooks -> Callback URL =
# https://<host>/webhook/whatsapp, Verify token = WHATSAPP_VERIFY_TOKEN.
# WHATSAPP_APP_SECRET valida X-Hub-Signature-256 en modo fail-closed: si falta,
# todo webhook entrante se rechaza con 403.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ----------------------------------------------------------------- scraping (opcional, local)
SCRAPER_URL=http://localhost:8081
SCRAPER_PORT=8081
MAPACHE_SCRAPE_INTERVAL=30
MAPACHE_ENRICH_TOP_N=3
MAPACHE_QUERIES_PER_CYCLE=2
